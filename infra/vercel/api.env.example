# Vercel project: strata-api (Root Directory: apps/api, framework fastify). Names only;
# values are set with `vercel env add` from files, never typed into a shell
# (docs/RUNBOOK.md, Vercel). Schema: apps/api/src/config.ts.
#
# NAME                    SECRET  ENVIRONMENTS           SOURCE
DATABASE_URL=           # yes     production             .secrets/neon_url (Neon pooled URL, D26)
                        #         preview                a Neon branch URL, never the production DB
CORS_ORIGINS=           # no      production, preview    https://<strata-web project>.vercel.app
STRATA_OWNER_ADDRESS=   # no      production             owner EVM address; admin routes stay off when unset
NODE_ENV=               # no      production             production
LOG_LEVEL=              # no      production, preview    info
RATE_LIMIT_MAX=         # no      optional               120
RATE_LIMIT_WINDOW_MS=   # no      optional               60000
# Never set ALLOW_MOCK in production; the API refuses to boot if it is.
