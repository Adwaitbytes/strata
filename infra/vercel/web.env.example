# Vercel project: strata-web (Root Directory: apps/web). Names only; set values with
# `vercel env add <NAME> <environment>` (see docs/RUNBOOK.md, Vercel). Everything here is
# public: NEXT_PUBLIC_* values are compiled into the browser bundle, so no secret may
# ever go in this file or in a NEXT_PUBLIC_* variable.
#
# NAME                          ENVIRONMENTS            EXAMPLE
NEXT_PUBLIC_STRATA_NETWORK=     # production, preview   testnet  (D33: release stage is TESTNET)
NEXT_PUBLIC_STRATA_API=         # production, preview   https://<strata-api project>.vercel.app
NEXT_PUBLIC_SITE_URL=           # production            https://<strata-web project>.vercel.app
