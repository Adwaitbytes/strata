    {
      "type": "timeseries",
      "title": "Cycle latency p50 / p95 / p99",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "strata-prometheus"
      },
      "description": "Quoting cycle duration. Target cycle is 1 to 3 s (PRD 9).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "strata-prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, agent) (rate(strata_agent_cycle_duration_seconds_bucket{network=~\"$network\", agent=~\"$agent\"}[5m])))",
          "legendFormat": "p50 {{agent}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "strata-prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, agent) (rate(strata_agent_cycle_duration_seconds_bucket{network=~\"$network\", agent=~\"$agent\"}[5m])))",
          "legendFormat": "p95 {{agent}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "strata-prometheus"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, agent) (rate(strata_agent_cycle_duration_seconds_bucket{network=~\"$network\", agent=~\"$agent\"}[5m])))",
          "legendFormat": "p99 {{agent}}"
        }
      ]
    },
