{
  "uid": "strata-overview",
  "title": "STRATA Overview",
  "tags": [
    "strata"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "network",
        "label": "Network",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "strata-prometheus"
        },
        "query": {
          "query": "label_values(up{job=~\"strata-.*\"}, network)",
          "refId": "v"
        },
        "definition": "label_values(up{job=~\"strata-.*\"}, network)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "agent",
        "label": "Agent",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "strata-prometheus"
        },
        "query": {
          "query": "label_values(strata_agent_halted{network=~\"$network\"}, agent)",
          "refId": "v"
        },
        "definition": "label_values(strata_agent_halted{network=~\"$network\"}, agent)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
