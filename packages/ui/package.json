{
  "name": "@strata/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./brand": "./src/brand.ts",
    "./tokens": "./src/tokens.ts",
    "./fonts": "./src/fonts.ts",
    "./theme.css": "./src/theme.css",
    "./assets/*": "./assets/*",
    "./data": "./src/data/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19",
    "next": "16.4.5",
    "react": "19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.0"
  }
}
