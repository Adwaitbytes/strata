{
  "name": "@strata/scorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "tsx src/main.ts",
    "score-once": "tsx src/main.ts --once --dry-run",
    "e2e:anvil": "tsx scripts/anvil-e2e.ts"
  },
  "dependencies": {
    "@strata/config": "workspace:*",
    "@strata/db": "workspace:*",
    "@strata/keys": "workspace:*",
    "@strata/sdk": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.5",
    "viem": "^2.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
