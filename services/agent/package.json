{
  "name": "@strata/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "start": "tsx src/core/main.ts",
    "fetch-markets": "tsx ../../scripts/fetch-markets.ts",
    "inj:grant-trading": "tsx src/injective/bin/grant-trading.ts",
    "inj:testnet-smoke": "tsx src/injective/bin/testnet-smoke.ts",
    "inj:balances": "tsx src/injective/bin/balances.ts",
    "inj:distribute": "tsx ../../scripts/distribute-testnet-funds.ts",
    "inj:stream-check": "tsx src/injective/bin/stream-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@injectivelabs/core-proto-ts-v2": "1.20.5",
    "@injectivelabs/networks": "1.20.66",
    "@injectivelabs/sdk-ts": "1.20.66",
    "@injectivelabs/utils": "1.20.66",
    "@protobuf-ts/grpcweb-transport": "2.11.1",
    "@protobuf-ts/runtime-rpc": "2.11.1",
    "@strata/config": "workspace:*",
    "@strata/db": "workspace:*",
    "@strata/keys": "workspace:*",
    "@strata/risk": "workspace:*",
    "@strata/sdk": "workspace:*",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "viem": "^2.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.0",
    "fast-check": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
